# Скопируй в .env (он в .gitignore) и заполни. Ключи не коммитить!

# GigaChat API: https://developers.sber.ru/gigachat
# РЕЖИМ 1 (новая платформа api.giga.chat): статичный API-ключ из кабинета.
# ВАЖНО: НЕ вставляй токен из примера кода в консоли — он одноразовый (~30 мин)!
# Нужен именно ключ из раздела «API-ключи».
GIGACHAT_API_KEY=
# РЕЖИМ 2 (классика, gigachat.devices.sberbank.ru): OAuth по ключу авторизации.
# «Ключ авторизации» — одна base64-строка БЕЗ точек. Если в строке есть точки
# (eyJ...eyJ...) — это НЕ тот ключ, сервер вернёт «Can't decode Authorization header».
GIGACHAT_CREDENTIALS=
# Вариант 2б: если есть только пара ключей из скачанного JSON — заполни их,
# base64 соберётся автоматически (приоритет у GIGACHAT_API_KEY, потом CREDENTIALS)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Скоуп (только для режима 2): GIGACHAT_API_PERS / GIGACHAT_API_B2B / GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Опционально: путь к CA-сертификату Сбера; если пусто — проверка SSL отключается
# (сертификаты Сбера подписаны российским CA, которого нет в стандартном хранилище Python)
GIGACHAT_CA_CERT=

# Альтернативный/резервный генератор (бесплатные модели OpenRouter)
OPENROUTER_API_KEY=

# Этапы 2-3
HF_TOKEN=
WANDB_API_KEY=
