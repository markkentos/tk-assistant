tk-assistant.ru {
	encode zstd gzip

	# Статический фронтенд + RAG-прокси
	handle /v1/* {
		reverse_proxy rag:8000
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer-when-downgrade
	}
}

www.tk-assistant.ru {
	redir https://tk-assistant.ru{uri}
}
